<?xml version="1.0" encoding="utf-8"?>
<!-- 메인(4x2 목표): 헤더(DailyRoll·날짜·새로고침) / 현재 금액 / 내일 예상 / 스트릭·계산 시각 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dailyroll_widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DailyRoll"
            android:textColor="@color/dailyroll_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dr_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/dailyroll_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dr_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/dailyroll_refresh"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/dailyroll_text_secondary"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/dr_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/dailyroll_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dr_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/dailyroll_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dr_add"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/dailyroll_chip_bg"
            android:contentDescription="@string/dailyroll_add"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/dailyroll_text"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dr_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:text="●"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/dr_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/dr_tomorrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/dailyroll_text"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/dr_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/dailyroll_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
